# À définir chez l'hébergeur (Vercel : Settings > Environment Variables). Ne committez jamais le vrai fichier.
UPSTREAM_URL=https://<adresse du modèle, sans /v1>
UPSTREAM_TOKEN=<identifiant>.<secret>
UPSTREAM_MODEL=<nom exact du modèle>
# ALLOWED_KEYS=cle-a,cle-b
# RATE_PER_MINUTE=60
# REASONING_EFFORT=low
